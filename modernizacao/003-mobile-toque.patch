-:root{font-family:Inter,ui-sans-serif,system-ui,'Segoe UI',sans-serif;background:#0b121b;color:#edf7f5;color-scheme:dark}
*{box-sizing:border-box}
body{margin:0}
button,select,input{font:inherit}
button{cursor:pointer}
button:disabled{opacity:.48;cursor:not-allowed}
a{color:inherit;text-decoration:none}
.shell{min-height:100vh;display:grid;grid-template-columns:236px minmax(0,1fr)}
.sidebar{background:#101b25;border-right:1px solid #263641;padding:26px 17px;display:flex;flex-direction:column;gap:29px;position:sticky;top:0;height:100vh}
.logo{font-size:17px;letter-spacing:-.6px;color:#bcf7dd;font-weight:700;line-height:1.4}
.logo b{color:#fafdfa}
.sidetitle,.eyebrow{font-size:10px;letter-spacing:1.5px;color:#8aafad;font-weight:800}
.sidebar nav{display:grid;gap:6px}
.nav{color:#b0c9c9;background:transparent;border:0;text-align:left;padding:14px 13px;border-radius:10px}
.nav.on,.nav:hover{background:#1a3b34;color:#b3fbd3}
.side-bottom{margin-top:auto;font-size:12px;color:#91a9ab;display:grid;gap:13px;line-height:1.6}
.side-bottom a{color:#7bd9ba}
.main{padding:28px clamp(17px,3.1vw,44px);max-width:1680px;min-width:0;width:100%}
.caveat{border:1px solid #75602e;background:#302719;border-radius:10px;color:#ffe1a4;font-size:11px;line-height:1.6;padding:10px 15px;margin-bottom:22px}
.head{display:flex;justify-content:space-between;gap:15px;align-items:flex-end;margin-bottom:25px}
.head h1{font-size:clamp(24px,3vw,42px);letter-spacing:-1.6px;line-height:1.08;margin:10px 0}
.head p{margin:0;color:#a9bec6;font-size:13px;line-height:1.6}
.status{font-size:12px;color:#abe7cc;text-align:right;line-height:1.8;white-space:nowrap}
.stats-cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-bottom:18px}
.stat,.panel{background:linear-gradient(150deg,#15232f,#111f29);border:1px solid #2b3c46;border-radius:14px}
.stat{padding:18px}
.stat small{display:block;color:#8da8ae;font-size:11px;letter-spacing:.2px}
.stat strong{font-size:27px;display:block;margin-top:8px;line-height:1.25}
.stat em{font-style:normal;font-size:13px;color:#95b5a9}
.stat .teamname{font-size:17px;line-height:1.4}
.panel{padding:22px;min-width:0;margin-bottom:16px}
.panel h2{font-size:17px;margin:0 0 17px}
.panel p{line-height:1.65;font-size:13px}
.muted{color:#9cbbc1}
.two-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:17px}
.welcome{max-width:1040px}
.welcome .two-cards{margin:24px 0}
.choose{border:1px solid #416c65;background:#16372f;border-radius:15px;color:#effefa;padding:26px;text-align:left;min-height:188px;display:flex;flex-direction:column;gap:12px;transition:background .15s,transform .15s}
.choose:hover{background:#215143;transform:translateY(-2px)}
.choose span{font-size:36px}
.choose b{font-size:22px}
.choose small{color:#b6ccce}
.versus{display:grid;grid-template-columns:1fr 45px 1fr;gap:12px;align-items:center;padding:12px 0 24px}
.versus div{font-size:20px;font-weight:750}
.versus span{font-size:11px;font-weight:800;color:#92d6b6;text-align:center}
.actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:15px}
.btn,.smallbtn{background:#203540;border:1px solid #37505a;color:#f0f8f6;border-radius:9px;padding:10px 13px;font-size:12px;font-weight:650;min-height:39px}
.btn:hover,.smallbtn:hover{background:#2f5255}
.btn.primary{background:#6ce3ae;color:#0c2823;border-color:#6ce3ae}
.btn.primary:hover{background:#8ef4cb}
.panelhead{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:12px}
.panelhead h2{margin:0}
.filter{font-size:12px;color:#9dbaaf;display:flex;align-items:center;gap:10px}
select{background:#20303a;color:#e5fff4;border:1px solid #35515b;border-radius:8px;padding:8px 9px;min-width:0;max-width:100%}
input[type=range]{accent-color:#6ce3ae;width:100%}
.fixture{display:grid;grid-template-columns:minmax(0,1fr) 60px minmax(0,1fr) auto;gap:9px;align-items:center;padding:12px 0;border-bottom:1px solid #2c4049;font-size:12px}
.fixture:last-child{border-bottom:0}
.fixture strong{text-align:center;font-size:16px}
.fixture .club{overflow-wrap:anywhere}
.fixture .smallbtn{padding:8px 10px;min-height:34px}
.pill{display:inline-block;background:#263c3f;border-radius:30px;padding:5px 9px;font-size:10px;color:#aedfd1}
.rounds{display:flex;gap:5px;flex-wrap:wrap}
.round{width:33px;height:33px;border-radius:7px;border:1px solid #3a525c;background:#1f3441;color:white}
.round.done{background:#24644b;border-color:#286b52}
.tablewrap{overflow:auto}
table{width:100%;border-collapse:collapse;white-space:nowrap}
th,td{padding:10px 10px;border-bottom:1px solid #2b424e;text-align:right;font-size:12px}
th:nth-child(2),td:nth-child(2){text-align:left}
th{color:#9aadb8;font-size:10px;text-transform:uppercase}
.mine{background:#1c453a}
.squadgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(185px,1fr));gap:10px}
.squaditem{background:#182f38;padding:12px;border:1px solid #294b56;border-radius:9px;display:flex;flex-direction:column;gap:7px;font-size:12px}
.squaditem small,.squaditem span{color:#8bb6b3}
.livegrid{display:grid;grid-template-columns:minmax(0,2.2fr) minmax(245px,1fr);gap:20px}
.scoreline{display:grid;grid-template-columns:1fr 90px 1fr auto;gap:12px;align-items:center;text-align:center;margin-bottom:13px}
.scoreline strong{font-size:29px;color:#c4fadb}
.scoreline span{font-size:13px;color:#87c9b0}
.scoreline div{font-weight:800;font-size:15px}
#pitch{width:100%;height:auto;display:block;border-radius:12px;border:1px solid #4b846e;box-shadow:0 12px 30px #0004}
.matchstats{display:flex;flex-wrap:wrap;gap:10px;margin-top:17px;font-size:11px;color:#abc5c0}
.matchstats span{background:#233741;padding:9px 12px;border-radius:8px}
.inner{background:#182c37;border:1px solid #28434e;border-radius:12px;padding:15px;margin-bottom:12px}
.inner h3{font-size:14px;margin:0 0 14px}
.inner label{display:flex;flex-direction:column;gap:7px;font-size:11px;color:#b5ccce;margin:12px 0}
.inner .btn{width:100%}
.feed{max-height:260px;overflow-y:auto}
.feed div{font-size:11px;padding:9px 0;border-bottom:1px solid #30434b;line-height:1.5}
.feed b{color:#7adbad}
.notice{background:#194432;border:1px solid #2e795c;color:#c9ffe1;border-radius:10px;padding:13px 17px;font-size:12px;margin:15px 0}
.footer{margin:38px 0 0;color:#869fa3;font-size:11px;border-top:1px solid #2c414b;padding-top:18px;line-height:2}
.footer button{background:transparent;color:#7fdcb3;border:none;padding:4px 6px}
.footer a{color:#73cda6}
@media(max-width:980px){.shell{grid-template-columns:1fr}
.sidebar{position:static;height:auto;padding:16px;gap:12px}
.sidebar nav{grid-template-columns:repeat(5,minmax(0,1fr));gap:4px}
.nav{text-align:center;padding:10px 4px;font-size:11px}
.sidetitle,.side-bottom{display:none}
.main{padding:17px}
.livegrid{grid-template-columns:1fr}
.livegrid aside{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.livegrid .inner:last-child{grid-column:1/-1}
}
@media(max-width:590px){.head{display:block}
.status{text-align:left;margin-top:14px}
.stats-cards{grid-template-columns:1fr 1fr}
.stats-cards .stat:last-child{grid-column:1/-1}
.two-cards{grid-template-columns:1fr}
.panel{padding:14px}
.fixture{grid-template-columns:1fr 50px 1fr;font-size:11px}
.fixture .smallbtn,.fixture .pill{grid-column:1/-1;justify-self:end}
.livegrid aside{display:block}
.scoreline{grid-template-columns:1fr 80px 1fr}
.scoreline span{grid-column:1/-1}
.sidebar nav{grid-template-columns:repeat(5,1fr)}
.nav{font-size:10px}
.choose{min-height:130px}
.versus{grid-template-columns:1fr 24px 1fr}
.versus div{font-size:15px}
}

